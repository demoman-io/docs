{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Demoman",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/demoman-logomark.svg",
    "dark": "/images/demoman-logomark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/demoman-logomark.svg",
    "dark": "/images/demoman-lockup-dark.svg",
    "href": "https://demoman.io"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@demoman.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/demoman_io",
      "github": "https://github.com/demoman-io"
    }
  },
  "description": "Demoman is a screen recorder for your coding agent. Describe what you want to show and your agent films it in a real browser, handing you back a finished product video with cursor smoothing, zooms and framing already done.",
  "fonts": {
    "heading": {
      "family": "Outfit",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  }
}
